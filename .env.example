# Local Docker Compose configuration.
# Copy this file to .env before starting the project:
#   Copy-Item .env.example .env
#
# These values target the Docker Compose network. Keep the PostgreSQL host
# as "postgres" and the LocalStack host as "localstack" when using Compose.

PORT=3000
DATABASE_URL=postgresql://wager:wager_local_only@postgres:5432/wagering

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_ENDPOINT=http://localstack:4566
SQS_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
SQS_EVENTS_QUEUE_URL=http://localstack:4566/000000000000/wager-events.fifo
